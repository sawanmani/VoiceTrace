# Copy this file to .env and configure as needed
VOICETRACE_CONFIG=config.yaml

# Required API key for both frontend and backend to authenticate WebSocket connections
# In production, securely inject this via a secrets manager (e.g., AWS Secrets Manager, Vault)
VOICETRACE_API_KEY=vt_live_9b4e6d3c2a1f0e8b7d6c5a4f3e2d1c0b

# Shared secret for dynamically generating TURN credentials (for coturn)
TURN_SHARED_SECRET=vt_turn_5a4f3e2d1c0b9b4e6d3c2a1f0e8b7d6c

# ── Twilio (for live phone call demo via /twilio/incoming + /ws/twilio) ──
# Get these from: https://console.twilio.com → Account → Auth Token
TWILIO_AUTH_TOKEN=

# Set to "true" to validate Twilio request signatures (recommended for public tunnels)
# Leave "false" for local testing without a real Twilio account
TWILIO_VALIDATE_SIGNATURE=false

# ── Alert Delivery (Fix L5: secrets belong here, NOT in config.yaml) ──────
# Telegram Bot — get token from @BotFather, chat_id from /getUpdates response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook — any URL that accepts POST JSON (e.g. Slack, Teams, n8n)
ALERT_WEBHOOK_URL=

# ── Redis (optional — enables multi-worker / K8s horizontal scaling) ──────
# Leave empty for single-process mode (in-process pub/sub, no Redis needed)
REDIS_URL=
